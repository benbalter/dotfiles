root = true

[*]
charset = utf-8
indent_style = space
indent_size = 2
trim_trailing_whitespace = true
end_of_line = lf
insert_final_newline = true

[*.{rb,rake,gemspec}]
indent_size = 2

[*.{js,jsx,ts,tsx,json,yml,yaml,html,css,scss}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# script/* and lib/* have no extension, but shfmt (script/lint) checks them
# with tabs too.
[{*.{sh,bash,bats},script/*,lib/*}]
indent_style = tab
switch_case_indent = true

[Makefile]
indent_style = tab

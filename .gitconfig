[core]
	excludesfile = ~/.gitignore
	attributesfile = ~/.config/git/attributes
	whitespace = fix,-indent-with-non-tab,trailing-space,cr-at-eol,space-before-tab
	pager = delta
	autocrlf = input
	editor = code --wait

[user]
	name = Ben Balter
	email = ben@balter.com
	signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIJVznDI5iSIoLzOLMW54ZU6fnCe9JHd/tetOimr9G3c5

[color]
	branch = auto
	diff = auto
	grep = auto
	interactive = auto
	pager = true
	showbranch = auto
	status = auto
	ui = auto

[color "interactive"]
	error = red bold

[color "branch"]
	current = yellow reverse
	local = yellow
	remote = green

[color "status"]
	added = yellow
	changed = green
	untracked = cyan
	branch = magenta

[apply]
	whitespace = fix

[github]
	user = benbalter

[push]
	default = simple
	autoSetupRemote = true
	followTags = true

[filter "lfs"]
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process

[delta]
	navigate = true
	side-by-side = true
	line-numbers = true

[interactive]
	diffFilter = delta --color-only

[merge]
	conflictstyle = zdiff3

[url "https://github.com"]
	insteadOf = git://github.com

[diff]
	tool = difftastic
	colorMoved = default
	algorithm = histogram

# `git diff` still uses delta (see core.pager); difftastic is opt-in via
# `git difftool` / `git dft`. VS Code remains available with `-t default-difftool`.
[difftool]
	prompt = false

[difftool "difftastic"]
	cmd = difft "$LOCAL" "$REMOTE"

[difftool "default-difftool"]
	cmd = code --wait --diff $LOCAL $REMOTE

# Page difftool output so difftastic's long diffs scroll like `git diff`.
[pager]
	difftool = true

[alias]
	dft = difftool

[init]
	defaultBranch = main

[transfer]
	fsckObjects = true

[fetch]
	fsckObjects = true
	prune = true
	pruneTags = true

[fetch "fsck"]
	zeroPaddedFilemode = ignore

[receive]
	fsckObjects = true

[rebase]
	autoStash = true
	autosquash = true
	updateRefs = true

[pull]
	rebase = false

[rerere]
	enabled = true
	autoUpdate = true

[commit]
	verbose = true
	gpgsign = true

[branch]
	sort = -committerdate

[tag]
	sort = version:refname
	gpgSign = true

[column]
	ui = auto

[gpg]
	format = ssh

[gpg "ssh"]
	allowedSignersFile = ~/.config/git/allowed_signers

# OS-specific overrides; git silently ignores missing include files,
# so only the file for the current OS is symlinked into ~
[include]
	path = ~/.gitconfig.macos
	path = ~/.gitconfig.linux

[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential

[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential

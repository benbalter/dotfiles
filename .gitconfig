[core]
	excludesfile = ~/.gitignore
	attributesfile = ~/.config/git/attributes
	whitespace = fix,-indent-with-non-tab,trailing-space,cr-at-eol,space-before-tab
	pager = delta
	autocrlf = input
	editor = code --wait
	# Skip re-scanning directories whose mtime hasn't changed during `git status`.
	untrackedCache = true

[user]
	name = Ben Balter
	email = ben@balter.com

[color]
	branch = auto
	diff = auto
	grep = auto
	interactive = auto
	pager = true
	showbranch = auto
	status = auto
	ui = auto

[color "interactive"]
	error = red bold

[color "branch"]
	current = yellow reverse
	local = yellow
	remote = green

[color "status"]
	added = yellow
	changed = green
	untracked = cyan
	branch = magenta

[apply]
	whitespace = fix

[github]
	user = benbalter

[push]
	default = simple
	autoSetupRemote = true
	followTags = true

[filter "lfs"]
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process

[delta]
	navigate = true
	side-by-side = true
	line-numbers = true

[interactive]
	diffFilter = delta --color-only

[merge]
	conflictstyle = zdiff3

[url "https://github.com"]
	insteadOf = git://github.com

[diff]
	tool = difftastic
	colorMoved = default
	algorithm = histogram
	# Detect copies as well as renames, so a copied file diffs against its source.
	renames = copies

# `git diff` still uses delta (see core.pager); difftastic is opt-in via
# `git difftool` / `git dft`. VS Code remains available with `-t default-difftool`.
[difftool]
	prompt = false

[difftool "difftastic"]
	cmd = difft "$LOCAL" "$REMOTE"

[difftool "default-difftool"]
	cmd = code --wait --diff $LOCAL $REMOTE

# Page difftool output so difftastic's long diffs scroll like `git diff`.
[pager]
	difftool = true

[alias]
	dft = difftool

[init]
	defaultBranch = main

[transfer]
	fsckObjects = true

[fetch]
	fsckObjects = true
	prune = true
	pruneTags = true

[fetch "fsck"]
	zeroPaddedFilemode = ignore

[receive]
	fsckObjects = true

[rebase]
	autoStash = true
	autosquash = true
	updateRefs = true

[pull]
	rebase = false

[rerere]
	enabled = true
	autoUpdate = true

[commit]
	verbose = true

[branch]
	sort = -committerdate

[tag]
	sort = version:refname

# With tag.sort above, list pre-releases before their release (v2.0.0-rc1
# before v2.0.0) instead of after it.
[versionsort]
	suffix = -alpha
	suffix = -beta
	suffix = -pre
	suffix = -rc

# Offer to run the command a typo most likely meant, instead of just failing.
[help]
	autocorrect = prompt

[column]
	ui = auto

[gpg "ssh"]
	allowedSignersFile = ~/.config/git/allowed_signers

# macOS-only settings: commit signing through 1Password and gh as the GitHub
# credential helper. Git ignores a missing include, and install.sh doesn't
# link this file on Linux: Codespaces configures its own signing and
# credentials, which ours overrode (commits failed with "Couldn't get agent
# socket").
[include]
	path = ~/.gitconfig.macos

# Untracked, per-machine settings (a work email, a host-specific credential
# helper) that shouldn't go in this public repo. Last, so it overrides
# everything above; git skips it if it doesn't exist.
[include]
	path = ~/.gitconfig.local

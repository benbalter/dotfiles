[credential]
	helper = osxkeychain

# gh for GitHub. The empty helper first clears any inherited ones; in the
# common .gitconfig that also cleared Codespaces' own helper, so pushes there
# depended on gh being installed.
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential

[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential

[user]
	signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIJVznDI5iSIoLzOLMW54ZU6fnCe9JHd/tetOimr9G3c5

[commit]
	gpgsign = true

[tag]
	gpgSign = true

[gpg]
	format = ssh

[gpg "ssh"]
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign

# Zed (installed via Brewfile cask) on macOS; .gitconfig's `code --wait`
# remains the default on Linux and in Codespaces
[core]
	editor = zed --wait

# fsmonitor runs a per-repo daemon that watches for file changes, so `git
# status` stops walking the whole tree. macOS only: git's built-in daemon
# doesn't support Linux (Codespaces).
[core]
	fsmonitor = true

# Clickable file names in delta's diffs (Ghostty supports OSC 8 links; less
# needs -R, which LESS sets). zed:// opens the file at that line in Zed rather
# than handing a bare file:// to Finder.
[delta]
	hyperlinks = true
	hyperlinks-file-link-format = "zed://file{path}:{line}"

# Hooks copied into every new clone; see the pre-commit hook for why this
# isn't a global core.hooksPath. Gitleaks is a macOS (Brewfile) tool, so this
# lives here rather than in .gitconfig.
[init]
	templateDir = ~/.config/git/template

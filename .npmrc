save-exact=true
fund=false
audit-level=high
# ~/.npmrc links here and this repo is public, so `npm login` would write
# its token into a tracked file. lib/aliases' npm() fills it from
# 1Password for commands that need auth; the `?` sends no auth when unset
# rather than the literal string.
//registry.npmjs.org/:_authToken=${NPM_TOKEN?}

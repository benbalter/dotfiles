Include ~/.colima/ssh_config

# Untracked, per-machine hosts and keys that shouldn't go in this public repo.
# First, because ssh keeps the first value it finds for each option, so it
# overrides Host * below; ssh skips it if it doesn't exist.
Include ~/.ssh/config.local

Host github.com
	User benbalter

# 1Password's SSH agent, but only where its socket exists. A work Mac doesn't
# install 1Password, and a forced IdentityAgent there left ssh warning about a
# missing socket and skipping the system agent, where Keychain-backed keys
# (UseKeychain, and the work commit-signing key) live. %d is the home
# directory, so this doesn't depend on the account name.
Match exec "test -S '%d/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock'"
	IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"

Host *
	AddKeysToAgent yes
	UseKeychain yes
	HashKnownHosts yes
	ServerAliveInterval 60
	ServerAliveCountMax 3
	ControlMaster auto
	ControlPath ~/.ssh/control-%C
	ControlPersist 600

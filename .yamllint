extends: default

rules:
  # GitHub Actions' `on:` key reads as a YAML 1.1 boolean; only values matter.
  truthy:
    check-keys: false
  line-length: disable
  document-start: disable
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  braces:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true

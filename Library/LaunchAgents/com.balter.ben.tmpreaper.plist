<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>Label</key>
		<string>com.balter.ben.tmpreaper</string>
		<!-- Through sh, which expands $HOME: launchd doesn't expand ~ or $HOME,
		     so these paths named /Users/benbalter and broke under any other
		     account name (launchd sets HOME for user agents).
		     Age by mtime, not tmpreaper's default atime: macOS (Finder,
		     QuickLook thumbnails) keeps bumping atime on everything in
		     Downloads, so almost nothing ever looked 5 days old. mtime-dir does
		     the same for directories, which walking into otherwise keeps fresh
		     forever. The log is there because launchd otherwise discards the
		     output, so there was no way to see that it deleted almost nothing. -->
		<key>ProgramArguments</key>
		<array>
			<string>/bin/sh</string>
			<string>-c</string>
			<string>exec /opt/homebrew/sbin/tmpreaper --mtime --mtime-dir --showdeleted 5d "$HOME/Downloads" >>"$HOME/Library/Logs/tmpreaper.log" 2&gt;&amp;1</string>
		</array>
		<key>StartCalendarInterval</key>
		<dict>
			<key>Hour</key>
			<integer>0</integer>
			<key>Minute</key>
			<integer>0</integer>
		</dict>
	</dict>
</plist>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>Label</key>
		<string>com.balter.ben.tmpreaper</string>
		<key>ProgramArguments</key>
		<array>
			<string>/opt/homebrew/sbin/tmpreaper</string>
			<!-- Age by mtime, not tmpreaper's default atime: macOS (Finder,
			     QuickLook thumbnails) keeps bumping atime on everything in
			     Downloads, so almost nothing ever looked 5 days old. mtime-dir
			     does the same for directories, which walking into otherwise
			     keeps fresh forever. -->
			<string>--mtime</string>
			<string>--mtime-dir</string>
			<string>--showdeleted</string>
			<string>5d</string>
			<string>/Users/benbalter/Downloads</string>
		</array>
		<!-- Without these, launchd discards the output, so there was no way to
		     see that it deleted almost nothing. launchd doesn't expand ~. -->
		<key>StandardOutPath</key>
		<string>/Users/benbalter/Library/Logs/tmpreaper.log</string>
		<key>StandardErrorPath</key>
		<string>/Users/benbalter/Library/Logs/tmpreaper.log</string>
		<key>StartCalendarInterval</key>
		<dict>
			<key>Hour</key>
			<integer>0</integer>
			<key>Minute</key>
			<integer>0</integer>
		</dict>
	</dict>
</plist>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>Label</key>
		<string>com.balter.ben.update</string>
		<key>Program</key>
		<string>/Users/benbalter/.files/script/update</string>
		<!-- Without these, launchd discards the job's output, so a failing
		     nightly step leaves no trace. launchd doesn't expand ~ or $HOME,
		     hence the absolute paths. -->
		<key>StandardOutPath</key>
		<string>/Users/benbalter/Library/Logs/dotfiles-update.log</string>
		<key>StandardErrorPath</key>
		<string>/Users/benbalter/Library/Logs/dotfiles-update.log</string>
		<key>StartCalendarInterval</key>
		<dict>
			<key>Hour</key>
			<integer>0</integer>
			<key>Minute</key>
			<integer>0</integer>
		</dict>
	</dict>
</plist>

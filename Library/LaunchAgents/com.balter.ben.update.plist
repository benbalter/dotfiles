<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>Label</key>
		<string>com.balter.ben.update</string>
		<!-- launchd doesn't expand ~ or $HOME in a plist, so these paths were
		     spelled out as /Users/benbalter and broke under any other account
		     name. The shell expands them instead (launchd sets HOME for user
		     agents). Without the log, launchd discards the job's output and a
		     failing nightly step leaves no trace; >> opens it O_APPEND, as
		     StandardOutPath did, which script/update's log trimming relies on. -->
		<key>ProgramArguments</key>
		<array>
			<string>/bin/sh</string>
			<string>-c</string>
			<string>exec "$HOME/.files/script/update" >>"$HOME/Library/Logs/dotfiles-update.log" 2&gt;&amp;1</string>
		</array>
		<key>StartCalendarInterval</key>
		<dict>
			<key>Hour</key>
			<integer>0</integer>
			<key>Minute</key>
			<integer>0</integer>
		</dict>
	</dict>
</plist>

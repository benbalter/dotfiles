{
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": false,
    "cloudflare@cloudflare": true,
    "typescript-lsp@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "impeccable@impeccable": true,
    "ruby-lsp@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "ponytail@ponytail": true,
    "agentic-actions-auditor@trailofbits": true,
    "open-sourcing@trailofbits": true,
    "supply-chain-risk-auditor@trailofbits": true,
    "insecure-defaults@trailofbits": true,
    "sharp-edges@trailofbits": true,
    "git-cleanup@trailofbits": true,
    "rea@rea": true
  },
  "extraKnownMarketplaces": {
    "cloudflare": {
      "source": {
        "source": "github",
        "repo": "cloudflare/skills"
      }
    },
    "impeccable": {
      "source": {
        "source": "github",
        "repo": "pbakaus/impeccable"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "trailofbits": {
      "source": {
        "source": "github",
        "repo": "trailofbits/skills"
      }
    },
    "rea": {
      "source": {
        "source": "github",
        "repo": "morluto/rea"
      }
    }
  },
  "env": {
    "PONYTAIL_DEFAULT_MODE": "lite",
    "PONYTAIL_SUBAGENT_MATCHER": "^(?!(explore|claude-code-guide)$)"
  },
  "pluginConfigs": {
    "ponytail@ponytail": {
      "options": {
        "ledger": false
      }
    }
  },
  "advisorModel": "opus",
  "skipWorkflowUsageWarning": true,
  "theme": "auto",
  "switchModelsOnFlag": true,
  "remoteControlAtStartup": false,
  "agentPushNotifEnabled": true,
  "inputNeededNotifEnabled": true,
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.files/claude/hooks/guard-bash"
          }
        ]
      },
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.files/claude/hooks/require-prior-art"
          }
        ]
      }
    ]
  }
}

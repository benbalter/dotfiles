#!/bin/sh
# Alias all the things!

# Git. Sourced after oh-my-zsh, so gcm, gl, gb and gr deliberately replace the
# git plugin's versions (checkout main, pull, branch, remote) with these.
alias gs="git status"
alias ga="git add"
alias gad="git add ."
alias gco="git checkout"
alias gc="git commit"
alias gcm="git commit -m"
alias gl="git log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --date=relative"
alias gp="git push"
alias gd="git diff"
alias gb="gh repo view --web"
alias gr="gh repo view"
# Not `reset` or `clean`: typing `reset` to fix a garbled terminal threw away
# uncommitted work, and script/audit-casks tells you to run `clean` to
# uninstall casks, which instead deleted merged branches.
alias greset="git reset HEAD --hard; git clean -f -d"
# Delete local branches merged into the default branch. Not a bare
# `git branch --merged`: from a feature branch that lists main itself (an
# ancestor of HEAD), so `-d` deleted main, and branches checked out in another
# worktree (`+`) passed a stray `+` to git. The unalias drops oh-my-zsh's git
# plugin alias of the same name, which would otherwise shadow this function.
unalias gclean 2>/dev/null || true
gclean() {
	base=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null) || base=main
	base=${base#origin/}
	git branch --merged "$base" |
		grep -vE "^[*+]|^[[:space:]]*(main|master|$base)\$" |
		xargs -r -n 1 git branch -d
}
alias ggb="git commit -m ':gem: bump'"
# Clone a repo and cd into it; if it's already cloned, cd in and pull instead
gccd() {
	if [ -d "$(basename "$1" .git)" ]; then
		cd "$(basename "$1" .git)" || return
		git pull
	else
		gh repo clone "$1" || return
		cd "$(basename "$1" .git)" || return
	fi
}
alias branches="git branch -v"

# zoxide
alias j='z'

# Modern CLI replacements (keep old muscle memory, get better tools).
# Originals remain reachable via a leading backslash, e.g. \cat or `command ls`.
if command -v bat >/dev/null; then
	alias cat='bat --paging=never'
fi
if command -v eza >/dev/null; then
	alias ls='eza --group-directories-first'
	alias ll='eza -l --git --group-directories-first'
	alias la='eza -la --git --group-directories-first'
	alias lc='eza -la --git --group-directories-first'
	alias lt='eza --tree --level=2'
else
	alias ll='ls -lh'
	alias la='ls -lAh'
	alias lc='ls -lA'
fi
if command -v xh >/dev/null; then
	alias http='xh'
	alias https='xhs'
fi
# find -> fd, grep -> rg and diff -> difft are intentionally NOT aliased:
# their flags are incompatible (`grep -h` suppresses filenames, `rg -h` prints
# help; `difft -u` is an error), which breaks muscle memory and pasted
# commands. Use `fd`, `rg` and `difft` directly.

# Zed: open the given paths, or the current directory (like oh-my-zsh's vsc)
zd() {
	if [ $# -gt 0 ]; then
		zed "$@"
	else
		zed .
	fi
}

# Script/*
alias sb="script/bootstrap"
alias sc="script/lint"

# Simple server
alias server="python3 -m http.server"

# Public IP. Not `ip`, which hid iproute2's `ip addr` on Linux.
alias myip="curl icanhazip.com"

# .files
# shellcheck disable=SC2139
alias up="$DOTFILES_ROOT/script/update"
# shellcheck disable=SC2139
alias setup="$DOTFILES_ROOT/script/setup"
# shellcheck disable=SC2139
alias clean="$DOTFILES_ROOT/script/clean"

# Misc
alias p="cd ~/projects"
alias c="claude"

# Make rm, cp and mv interactive (-i) as a safety net, but not under Claude
# Code: its shell inherits these aliases but has no TTY to answer the prompt,
# so its commands hung until it learned to type `command rm`.
if [ -z "${CLAUDECODE-}" ]; then
	alias rm='rm -i'
	alias cp='cp -i'
	alias mv='mv -i'
fi

if [ "$(uname)" = "Darwin" ]; then
	alias flushdns="sudo dscacheutil -flushcache;sudo killall -HUP mDNSResponder; echo 'Flushed DNS, btw here is your hosts file just in case:'; cat /etc/hosts"
	# Sleep the display, which locks the screen. The old CGSession -suspend
	# binary no longer exists.
	alias afk="pmset displaysleepnow"
fi

# .npmrc reads the registry token from $NPM_TOKEN rather than storing it in
# this public repo. Fetch it from 1Password only for commands that need auth,
# so everyday installs don't trigger a Touch ID prompt.
npm() {
	# `npm login` and `npm config set` save tokens to ~/.npmrc, which links
	# into this public repo, so a login left a live token one `git add` away
	# from being published (twice). `command npm` bypasses this.
	case "${1-}" in
		login | adduser | add-user)
			echo "npm: ~/.npmrc links into the public dotfiles repo, so npm $1 would write a token there." >&2
			echo "Create a token at https://www.npmjs.com (Access Tokens) and save it to 1Password's npmjs.com item instead; npm() reads it from there." >&2
			return 1
			;;
		config | c | set)
			case "$*" in
				*_auth* | *_password*)
					echo "npm: ~/.npmrc links into the public dotfiles repo; keep credentials in 1Password, not npm config." >&2
					return 1
					;;
			esac
			;;
	esac
	if [ -z "${NPM_TOKEN-}" ] && command -v op >/dev/null 2>&1; then
		case "${1-}" in
			publish | unpublish | deprecate | dist-tag | owner | access | token | whoami)
				NPM_TOKEN="$(op read 'op://Private/hhpwgv7riqeklozdk5sjs4lel4/Saved on www.npmjs.com/access token')" command npm "$@"
				return
				;;
		esac
	fi
	command npm "$@"
}

#!/bin/bash
# Set up some common global variables
# This file is sourced by interactive shells; do NOT use `set -e`/`set -u`
# as that would alter the parent shell's behavior.

# Used internally
DOTFILES_ROOT=${DOTFILES_ROOT:-"$HOME/.files"}
export DOTFILES_ROOT

# Resolve the Homebrew prefix by probing known paths rather than shelling out
# to `brew --prefix`. Under Workbrew, `brew` is a setuid wrapper that can fail
# outright (Homebrew 7.0 refuses to run when real and effective UIDs differ),
# and a failed `brew --prefix` leaves HOMEBREW_PREFIX empty -- which silently
# skips every `$HOMEBREW_PREFIX/share/...` source line in .zshrc. Probing paths
# keeps the shell fully loaded even when brew itself is broken, and skips two
# subprocesses per shell start. Exporting it also short-circuits the identical
# `brew --prefix` call in oh-my-zsh's brew plugin.
for _brew_prefix in /opt/homebrew /home/linuxbrew/.linuxbrew "$HOME/.linuxbrew" /usr/local; do
	if [ -x "$_brew_prefix/bin/brew" ]; then
		HOMEBREW_PREFIX="$_brew_prefix"
		export HOMEBREW_PREFIX
		break
	fi
done
unset _brew_prefix

# Completions shipped by Homebrew formulae. Set here rather than in .zprofile
# so non-login shells (Codespaces, `zsh -i`) get them too, and because this
# must precede the compinit that oh-my-zsh runs.
if [ -n "${HOMEBREW_PREFIX:-}" ]; then
	# Deliberately not exported: zsh ties FPATH to the fpath array and rebuilds
	# it per shell, so exporting would re-prepend this on every nested shell.
	# shellcheck disable=SC2034
	FPATH="$HOMEBREW_PREFIX/share/zsh/site-functions${FPATH:+:$FPATH}"
fi

GOPATH=$HOME/go
export GOPATH

# From the probed prefix, so non-login Linux shells get Linuxbrew's binaries
# too (.zprofile's `brew shellenv` only runs for login shells), and macOS
# doesn't get a nonexistent /opt/homebrew on Linux.
PATH="/usr/local/bin:/usr/local/sbin:$GOPATH/bin:$PATH"
if [ -n "${HOMEBREW_PREFIX:-}" ] && [ "$HOMEBREW_PREFIX" != /usr/local ]; then
	PATH="$HOMEBREW_PREFIX/bin:$HOMEBREW_PREFIX/sbin:$PATH"
fi
# Workbrew (enterprise-managed Homebrew) forces every `brew` invocation through
# its wrapper at /opt/workbrew/bin; it must precede /opt/homebrew/bin or brew
# aborts with a "conflicting Homebrew wrapper configuration" error. No-op on
# Linux and on Macs without Workbrew.
if [ -x /opt/workbrew/bin/brew ]; then
	PATH="/opt/workbrew/bin:$PATH"
fi
export PATH

# ZSH settings and initializations
ZSH=$HOME/.oh-my-zsh
export ZSH

if command -v zsh >/dev/null 2>&1; then
	SHELL=$(command -v zsh)
	export SHELL
fi

ZSH_THEME=""
export ZSH_THEME

DISABLE_UPDATE_PROMPT=true
export DISABLE_UPDATE_PROMPT

COMPLETION_WAITING_DOTS="true"
export COMPLETION_WAITING_DOTS

# You've got mail
unset MAILCHECK

EDITOR=${EDITOR:-$(command -v code >/dev/null && echo "code --wait" || echo vi)}
VISUAL="$EDITOR"
export EDITOR VISUAL

# ripgrep reads default flags from ~/.ripgreprc
export RIPGREP_CONFIG_PATH="$HOME/.ripgreprc"

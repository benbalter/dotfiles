#!/bin/sh
# Per-machine profile: "personal" (the default) or "work" (an employer-managed
# Mac). Set it in the untracked ~/.config/dotfiles/env, which may also export
# machine-specific variables (a TLS-inspecting proxy's CA bundle, say) that the
# nightly script/update needs. ~/.zshrc.local can't carry those: launchd runs
# update with a bare environment that never reads it.
#
# MDM enrollment can't tell the two apart, because the personal Mac is enrolled
# too (for anti-theft), so the profile is set explicitly.
#
# Sourced by lib/globals (interactive shells), script/update and
# script/doctor, so it must stay POSIX and must not use `set -e`/`set -u`.

DOTFILES_ENV_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/dotfiles/env"
# shellcheck disable=SC1090
[ -r "$DOTFILES_ENV_FILE" ] && . "$DOTFILES_ENV_FILE"
DOTFILES_PROFILE="${DOTFILES_PROFILE:-personal}"
export DOTFILES_PROFILE

# Where update and backup record their last run, and update's lock. Defined
# once because doctor reads what they write: with a path spelled out in each
# script, changing one side would leave doctor reporting "no update has run".
DOTFILES_STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles"
DOTFILES_UPDATE_LOCK="${XDG_CACHE_HOME:-$HOME/.cache}/dotfiles-update.lock"
export DOTFILES_STATE_DIR DOTFILES_UPDATE_LOCK

# Print a Brewfile's entries of one type, one per line: names for brew, cask
# and tap, and App Store ids (without the _ separators) for mas. The one place
# that knows how a Brewfile line is written; update and the skip list both
# parse it.
# Usage: dotfiles_brewfile_entries <brew|cask|tap|mas> <Brewfile>
dotfiles_brewfile_entries() {
	[ -r "$2" ] || return 0
	if [ "$1" = mas ]; then
		sed -n 's/^mas .*id: *\([0-9_]*\).*/\1/p' "$2" | tr -d _
	else
		sed -n "s/^$1 '\([^']*\)'.*/\1/p" "$2"
	fi
}

# Add the Brewfile entries listed in Brewfile.work-skip to brew bundle's
# HOMEBREW_BUNDLE_*_SKIP variables on a work Mac, keeping any skips the caller
# already set. `<type> *` skips every Brewfile entry of that type except the
# ones opted back in with `!<type> <name>` (a mas entry's name is its id), so
# a work Mac installs only the casks and App Store apps chosen for it.
# Usage: dotfiles_bundle_skip <dotfiles root>
dotfiles_bundle_skip() {
	[ "$DOTFILES_PROFILE" = work ] || return 0
	_skip_list="$1/Brewfile.work-skip"
	[ -r "$_skip_list" ] || return 0
	for _type in brew cask mas tap; do
		_names=$(sed -n "s/^$_type  *\([^ #]*\).*/\1/p" "$_skip_list")
		if printf '%s\n' "$_names" | grep -qx '\*'; then
			_keep=$(sed -n "s/^!$_type  *\([^ #]*\).*/\1/p" "$_skip_list")
			_names=$(dotfiles_brewfile_entries "$_type" "$1/Brewfile")
			[ "$_type" != mas ] || _keep=$(printf '%s' "$_keep" | tr -d _)
			# An empty pattern list would match, and drop, every name.
			[ -z "$_keep" ] || _names=$(printf '%s\n' "$_names" | grep -vxF "$_keep" || true)
		fi
		_names=$(printf '%s' "$_names" | tr '\n' ' ')
		[ -n "$_names" ] || continue
		_var="HOMEBREW_BUNDLE_$(printf %s "$_type" | tr '[:lower:]' '[:upper:]')_SKIP"
		eval "_have=\${$_var:-}"
		# shellcheck disable=SC2154
		eval "$_var=\"\${_have:+\$_have }\$_names\""
		export "${_var?}"
	done
	unset _skip_list _type _names _keep _var _have
}

# Disable the mise tools Brewfile.work-skip lists (`mise <tool>`) on a work
# Mac, through mise's own MISE_DISABLE_TOOLS, so `mise install` and `mise
# upgrade` leave them out and doctor doesn't call them missing. lib/profile
# calls it as it's sourced, so shells, update and doctor all agree.
# Usage: dotfiles_mise_skip <dotfiles root>
dotfiles_mise_skip() {
	[ "$DOTFILES_PROFILE" = work ] || return 0
	[ -r "$1/Brewfile.work-skip" ] || return 0
	_names=$(sed -n 's/^mise  *\([^ #]*\).*/\1/p' "$1/Brewfile.work-skip" | tr '\n' ',')
	_names=${_names%,}
	[ -n "$_names" ] || return 0
	MISE_DISABLE_TOOLS="${MISE_DISABLE_TOOLS:+$MISE_DISABLE_TOOLS,}$_names"
	export MISE_DISABLE_TOOLS
	unset _names
}

# Install the Brewfile's missing VS Code extensions with `code` itself when the
# env file points NODE_EXTRA_CA_CERTS at a TLS-inspecting proxy's CA. brew
# bundle runs `code --install-extension` in Homebrew's filtered environment,
# which drops that variable, and VS Code's CLI ignores its system-certificate
# settings, so every extension fails on the proxy's self-signed chain. Once
# they're installed here, bundle finds them and moves on. Failures are left
# for bundle to report.
# Usage: dotfiles_vscode_extensions <dotfiles root>
dotfiles_vscode_extensions() {
	[ -n "${NODE_EXTRA_CA_CERTS:-}" ] || return 0
	_code=$(command -v code || echo /opt/homebrew/bin/code)
	[ -x "$_code" ] || return 0
	# || true: callers run under set -e and pipefail, so a failing `code` here
	# aborted the rest of the nightly update, backup included.
	_have=$("$_code" --list-extensions 2>/dev/null | tr '[:upper:]' '[:lower:]') || true
	# xargs splits the list, which zsh (sourcing this file) wouldn't do for an
	# unquoted variable. -r: with nothing missing, a bare `code` opens a window.
	sed -n "s/^vscode '\([^']*\)'.*/\1/p" "$1/Brewfile" | tr '[:upper:]' '[:lower:]' |
		grep -vxF "${_have:-.}" | sed 's/^/--install-extension /' |
		xargs -r "$_code" >/dev/null 2>&1 || true
	unset _code _have
}

# Load a work Mac's local commit-signing key (DOTFILES_SSH_SIGNING_KEY, its
# public key) into the system agent from the Keychain when it isn't there.
# git signs through ssh-keygen, which asks the agent, and after a reboot the
# agent is empty until an ssh connection loads the key, so the first commit
# of the day failed to sign. lib/globals calls it for interactive shells.
# Usage: dotfiles_load_signing_key
dotfiles_load_signing_key() {
	[ "$DOTFILES_PROFILE" = work ] || return 0
	[ -r "${DOTFILES_SSH_SIGNING_KEY:-}" ] || return 0
	_fp=$(ssh-keygen -lf "$DOTFILES_SSH_SIGNING_KEY" 2>/dev/null | awk '{ print $2 }')
	[ -n "$_fp" ] || return 0
	ssh-add -l 2>/dev/null | grep -qF "$_fp" ||
		ssh-add --apple-load-keychain -q >/dev/null 2>&1 || true
	unset _fp
}

# Record a profile in the env file, replacing any DOTFILES_PROFILE line already
# there and keeping the rest (a CA bundle, say). script/setup --work calls it,
# so a new work Mac can't run setup on the personal profile by mistake.
# Usage: dotfiles_set_profile <personal|work>
dotfiles_set_profile() {
	case "$1" in
		personal | work) ;;
		*)
			echo "dotfiles_set_profile: unknown profile '$1' (personal or work)" >&2
			return 1
			;;
	esac
	mkdir -p "${DOTFILES_ENV_FILE%/*}"
	if [ -f "$DOTFILES_ENV_FILE" ]; then
		grep -v '^\(export \)\{0,1\}DOTFILES_PROFILE=' "$DOTFILES_ENV_FILE" >"$DOTFILES_ENV_FILE.tmp" || true
		mv "$DOTFILES_ENV_FILE.tmp" "$DOTFILES_ENV_FILE"
	fi
	echo "DOTFILES_PROFILE=$1" >>"$DOTFILES_ENV_FILE"
	DOTFILES_PROFILE=$1
	export DOTFILES_PROFILE
}

# The repo root: lib/globals sets DOTFILES_ROOT, and every macOS checkout (the
# only place a work profile exists) lives at ~/.files.
dotfiles_mise_skip "${DOTFILES_ROOT:-$HOME/.files}"

{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>benbalter/renovate-config:instant"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "The mSCP commit script/audit-baseline runs checks from",
      "managerFilePatterns": [
        "/^config\\.yml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>git-refs) depName=(?<depName>\\S+) branch=(?<currentValue>\\S+)\\n\\s+commit: (?<currentDigest>[a-f0-9]{40})"
      ]
    },
    {
      "customType": "regex",
      "description": "Lint tool pins in script/install-lint-tools (its checksums need a manual update)",
      "managerFilePatterns": [
        "/^script/install-lint-tools$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n[A-Z_]+_VERSION=(?<currentValue>\\S+)"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "A version bump needs new checksums pasted in by hand",
      "matchManagers": [
        "custom.regex"
      ],
      "automerge": false
    },
    {
      "description": "ansible-core can't import on Python 3.15 (dataclasses._is_type is gone). Hold the Python Ansible runs on until a release supports it.",
      "matchDepNames": [
        "python"
      ],
      "matchFileNames": [
        ".python-version"
      ],
      "allowedVersions": "<3.15"
    },
    {
      "description": "TypeScript 7 ships no tsserver, which typescript-language-server falls back to. Hold the global one below 7.",
      "matchDepNames": [
        "npm:typescript",
        "typescript"
      ],
      "matchFileNames": [
        ".config/mise/config.toml"
      ],
      "allowedVersions": "<7"
    }
  ]
}

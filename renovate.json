{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>benbalter/renovate-config:instant"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Lint tool pins in script/install-lint-tools (its checksums need a manual update)",
      "managerFilePatterns": [
        "/^script/install-lint-tools$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n[A-Z_]+_VERSION=(?<currentValue>\\S+)"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "A version bump needs new checksums pasted in by hand",
      "matchManagers": [
        "custom.regex"
      ],
      "automerge": false
    }
  ]
}

#!/bin/sh

set -eu
# shellcheck disable=SC3040
(set -o pipefail) 2>/dev/null && set -o pipefail || true

# Run the playbook, passing any arguments through to ansible-playbook.
# Usage: script/ansible [--tags security] [--check --diff] ...

cd "$(dirname "$0")/.."

script/blocking-io

# shellcheck disable=SC1091
. env/bin/activate

# The playbook turns on Touch ID for sudo, so a become task's sudo shows a
# Touch ID dialog before any password prompt, and Ansible's default 10-second
# wait for it ran out ("Timed out waiting for become success") whenever the
# dialog wasn't answered at once.
export ANSIBLE_TIMEOUT="${ANSIBLE_TIMEOUT:-60}"

if [ "${CI:-}" = "true" ]; then
	ansible-playbook playbook.yml "$@"
elif [ -n "${ANSIBLE_BECOME_PASSWORD_FILE:-}" ]; then
	# Ansible reads the password out of that file itself -- nothing to prompt for.
	ansible-playbook playbook.yml "$@"
elif [ -t 0 ]; then
	ansible-playbook playbook.yml --ask-become-pass "$@"
elif sudo -n true 2>/dev/null; then
	# Nowhere to prompt, but sudo doesn't want a password here anyway.
	ansible-playbook playbook.yml "$@"
else
	echo "==> No terminal to prompt for your sudo password." >&2
	echo "    Run script/ansible from a terminal tab (Claude Code's ! prefix" >&2
	echo "    doesn't give it one), or point ANSIBLE_BECOME_PASSWORD_FILE at a" >&2
	echo "    file holding it." >&2
	exit 1
fi

deactivate

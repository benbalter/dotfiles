#!/bin/sh

set -eu
# shellcheck disable=SC3040
(set -o pipefail) 2>/dev/null && set -o pipefail || true

cd "$(dirname "$0")/.."

# Ansible's Python comes from .python-version alone. The fallback used to be
# whatever python3 was on PATH: mise's global Python (which Renovate moved to
# 3.15, where ansible-core can't import) or, on a fresh Mac, Apple's 3.9.
# uv downloads a matching Python when none is installed, and rebuilds env/
# when the pin changes. It comes from the Brewfile, but setup runs this
# before the playbook installs Homebrew, so fetch it standalone if missing.
if ! command -v uv >/dev/null; then
	echo "==> Installing uv to ~/.local/bin..."
	curl -LsSf https://astral.sh/uv/install.sh |
		env UV_INSTALL_DIR="$HOME/.local/bin" UV_NO_MODIFY_PATH=1 sh
	PATH="$HOME/.local/bin:$PATH"
fi

# --allow-existing: newer uv refuses (or, without a TTY, fails) to reuse
# an existing env/ otherwise, and setup runs this on every pass.
uv venv --allow-existing --python "$(cat .python-version)" env
# shellcheck disable=SC1091
. env/bin/activate
uv pip install --upgrade -r requirements.txt

script/blocking-io
# Not --force, which re-downloads every collection on every run. The pins are
# exact, so a plain install already converges on them.
ansible-galaxy collection install -r requirements.yml

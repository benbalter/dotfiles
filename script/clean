#!/bin/sh
# Uninstall everything not in the Brewfile, e.g. casks script/audit-casks
# commented out as PROPOSED REMOVAL.
# Usage: script/clean

set -eu
# shellcheck disable=SC3040
(set -o pipefail) 2>/dev/null && set -o pipefail || true

cd "$(dirname "$0")/.."

# The Brewfile only describes macOS. On Linux, cleanup would uninstall
# everything brew has installed.
if [ "$(uname)" != "Darwin" ]; then
	echo "script/clean is macOS-only" >&2
	exit 1
fi

# The repo's Brewfile, not --global, so this works before setup links ~/.Brewfile.
brew bundle cleanup --file=Brewfile --force

#!/bin/sh
# Check that this machine matches the dotfiles: every configured symlink
# points into the repo, no stale .bak files are left from setup, Homebrew
# resolves to the right binary, every launch agent is loaded and healthy, the
# last update run succeeded and isn't hung, nothing in the Brewfile or mise
# config is missing, macOS security settings and config.yml's defaults are
# still in place, tracked app preferences haven't drifted, and the repo is
# ready for `up` (venv present, tree clean).
# Read-only; exits non-zero if anything needs attention.
# Usage: script/doctor

set -eu
# shellcheck disable=SC3040
(set -o pipefail) 2>/dev/null && set -o pipefail || true

# This script's own checkout unless DOTFILES_ROOT says otherwise: only .zshrc
# exports it, and the repo isn't always at ~/.files (Codespaces).
DOTFILES_ROOT="${DOTFILES_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}"
CONFIG="$DOTFILES_ROOT/config.yml"
problems=0
# DOTFILES_PROFILE, plus dotfiles_bundle_skip for the Brewfile check below.
# shellcheck source=lib/profile
. "$(dirname "$0")/../lib/profile"

ok() { echo "  ok    $1"; }
bad() {
	echo "  FAIL  $1"
	problems=$((problems + 1))
}
warn() { echo "  warn  $1"; }

# Linux gets only the common lists: those are what install.sh links there.
files_query='.dotfiles_files_common[]'
[ "$(uname)" != "Darwin" ] || files_query="$files_query, .dotfiles_files_macos[]"
links_query='.dotfile_links_common[] | [.src, .dest] | @tsv'

# check_link <repo path> <path under $HOME>
check_link() {
	target="$HOME/$2"
	if [ -L "$target" ]; then
		actual=$(readlink "$target")
		if [ "$actual" = "$DOTFILES_ROOT/$1" ]; then
			ok "$target"
		else
			bad "$target points to $actual, expected $DOTFILES_ROOT/$1"
		fi
	elif [ -e "$target" ]; then
		bad "$target is a regular file, not a symlink (run script/setup)"
	else
		bad "$target is missing (run script/setup)"
	fi
	# The playbook moves a pre-existing file to .bak before linking. Once the
	# link is in place, a leftover .bak is either obsolete or holds local edits
	# that never made it into the repo; either way it wants a look. A second
	# backup gets a timestamp suffix (.bak.<epoch>) rather than replacing it.
	for bak in "$target.bak" "$target".bak.*; do
		if [ -e "$bak" ]; then
			warn "$bak left over from setup; merge or delete it"
		fi
	done
}

echo "==> Dotfile symlinks"
if command -v yq >/dev/null; then
	# Heredocs, not pipes: a piped `while` runs in a subshell and would lose
	# the $problems count.
	files=$(yq -r "$files_query" "$CONFIG")
	while IFS= read -r file; do
		check_link "$file" "$file"
	done <<EOF
$files
EOF
	links=$(yq -r "$links_query" "$CONFIG")
	tab=$(printf '\t')
	while IFS="$tab" read -r src dest; do
		check_link "$src" "$dest"
	done <<EOF
$links
EOF
else
	bad "yq not found; can't read config.yml (brew install yq)"
fi

# install.sh doesn't install Homebrew on Linux, so it is only checked on macOS.
if [ "$(uname)" = "Darwin" ]; then
	echo "==> Homebrew"
	# Workbrew's wrapper must win over /opt/homebrew/bin/brew, or brew aborts with
	# a wrapper-conflict error (see lib/globals).
	if [ -x /opt/workbrew/bin/brew ]; then
		brew_path=$(command -v brew || true)
		if [ "$brew_path" = /opt/workbrew/bin/brew ]; then
			ok "brew resolves to the Workbrew wrapper"
		else
			bad "brew resolves to ${brew_path:-nothing}, expected /opt/workbrew/bin/brew"
		fi
	elif command -v brew >/dev/null; then
		ok "brew at $(command -v brew)"
	else
		bad "brew not found on PATH"
	fi
fi

# plist_string <plist> <key>: a top-level <string> value. sed, not plutil, so
# this also runs (and is tested) where plutil doesn't exist.
plist_string() {
	sed -n "/<key>$2<\/key>/{n;s/.*<string>\(.*\)<\/string>.*/\1/p;}" "$1"
}

# plist_log <plist>: where a job's output goes. StandardOutPath, or the file
# its `sh -c` command appends to: the repo's agents redirect in the shell,
# since launchd doesn't expand $HOME in a plist.
plist_log() {
	plist_log=$(plist_string "$1" StandardOutPath)
	# shellcheck disable=SC2016 # a literal $HOME, as the plist spells it
	[ -n "$plist_log" ] ||
		plist_log=$(sed -n 's/.*>>"\$HOME\/\([^"]*\)".*/\1/p' "$1" | sed "s|^|$HOME/|" | head -1)
	echo "$plist_log"
}

if command -v launchctl >/dev/null; then
	echo "==> Launch agents"
	# Every agent the repo ships, not just the update job: tmpreaper once ran
	# nightly for months deleting almost nothing, and nobody could tell, because
	# it exited 0 and logged nowhere.
	for plist in "$DOTFILES_ROOT"/Library/LaunchAgents/*.plist; do
		[ -f "$plist" ] || continue
		label=$(plist_string "$plist" Label)
		log=$(plist_log "$plist")
		job="gui/$(id -u)/$label"
		if info=$(launchctl print "$job" 2>/dev/null); then
			code=$(echo "$info" | sed -n 's/^[[:space:]]*last exit code = //p' | head -1)
			case "$code" in
				0 | "(never exited)") ok "$label loaded, last exit code ${code:-unknown}" ;;
				*) bad "$label last exit code $code${log:+; see $log}" ;;
			esac
		else
			bad "$label is not loaded (launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/${plist##*/})"
		fi
		[ -n "$log" ] || warn "$label has no log (StandardOutPath or a >> redirect); its output is discarded"
	done
fi

echo "==> Last update run"
# script/update records each run here. The exit code above says only that the
# last nightly run failed; this says which steps, covers terminal runs and
# Linux, and its age catches a job that is loaded but no longer running.
STATUS="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles/update-status"
if [ -f "$STATUS" ]; then
	started=$(sed -n 's/^started=//p' "$STATUS")
	if grep -q '^failed=' "$STATUS"; then
		failed_steps=$(sed -n 's/^failed=//p' "$STATUS")
		while IFS= read -r failed_step; do
			bad "run started $started failed: $failed_step"
		done <<EOF
$failed_steps
EOF
	elif grep -q '^finished=' "$STATUS"; then
		ok "run started $started finished cleanly"
	else
		warn "run started $started never finished (killed, or still running)"
	fi
	# find -mtime is the portable way to ask a file's age (stat's flags differ
	# between BSD and GNU). +1 means at least two whole days.
	# Only macOS schedules script/update (the launch agent); on Linux it runs
	# when you run `up`, so a quiet week isn't a fault there.
	if [ -n "$(find "$STATUS" -mtime +1)" ]; then
		if [ "$(uname)" = "Darwin" ]; then
			bad "no update has run in 2+ days (last started $started); is the job loaded?"
		else
			warn "no update has run in 2+ days (last started $started); run up"
		fi
	fi
else
	warn "no update has run yet (no $STATUS)"
fi

# A hung step (mas waiting on an App Store sign-in, say) holds script/update's
# lock, and every later run then skips itself without failing.
LOCK="${XDG_CACHE_HOME:-$HOME/.cache}/dotfiles-update.lock"
if [ -d "$LOCK" ]; then
	pid=$(cat "$LOCK/pid" 2>/dev/null || true)
	if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
		if [ -n "$(find "$LOCK" -maxdepth 0 -mmin +120)" ]; then
			bad "update PID $pid has held $LOCK for 2+ hours; likely hung (kill $pid)"
		else
			ok "update running now (PID $pid)"
		fi
	else
		warn "stale lock $LOCK from dead PID ${pid:-unknown}; the next run reclaims it"
	fi
fi

echo "==> Packages"
# A failed install is skipped quietly (brew bundle and mise carry on), so
# ask what's still missing. --no-upgrade: outdated isn't missing; `up` handles
# that.
if [ "$(uname)" = "Darwin" ] && command -v brew >/dev/null; then
	# The repo's Brewfile, not --global, so this still works before setup links
	# ~/.Brewfile.
	export HOMEBREW_BUNDLE_FILE="$DOTFILES_ROOT/Brewfile"
	# A work Mac doesn't install Brewfile.work-skip's entries, so it doesn't
	# count them as missing either.
	dotfiles_bundle_skip "$DOTFILES_ROOT"
	[ "$DOTFILES_PROFILE" = personal ] || ok "profile: $DOTFILES_PROFILE (from $DOTFILES_ENV_FILE)"
	if missing=$(brew bundle check --no-upgrade --verbose 2>&1); then
		ok "every Brewfile entry installed"
	else
		bad "Brewfile entries not installed (brew bundle install --file=$HOMEBREW_BUNDLE_FILE --no-upgrade):"
		echo "$missing" | sed -nE 's/^(→|->) */        /p'
	fi
fi
if command -v mise >/dev/null; then
	# From $HOME, so mise reads the symlinked global config.
	missing=$(cd "$HOME" && mise ls --missing 2>/dev/null || true)
	if [ -z "$missing" ]; then
		ok "every mise tool installed"
	elif [ "$(uname)" = "Darwin" ]; then
		bad "mise tools not installed (mise install):"
		echo "$missing" | sed 's/^/        /'
	else
		# install.sh links the full mise config but installs only a few tools,
		# so a Codespace always has the rest missing.
		warn "mise tools not installed (mise install to add them):"
		echo "$missing" | sed 's/^/        /'
	fi
fi

if [ "$(uname)" = "Darwin" ]; then
	echo "==> Security"
	# Read back what the playbook's security block set. It only runs with
	# script/setup, so nothing else would notice an OS update or an app
	# turning one of these off.
	# Overridable so tests can stub them; everything else here is found on PATH.
	fw=${SOCKETFILTERFW:-/usr/libexec/ApplicationFirewall/socketfilterfw}
	sudo_local=${SUDO_LOCAL:-/etc/pam.d/sudo_local}
	check_security() { # <description> <expected substring> <command>...
		desc=$1 want=$2
		shift 2
		if "$@" 2>/dev/null | grep -q "$want"; then
			ok "$desc"
		elif [ "$DOTFILES_PROFILE" = work ]; then
			# The playbook leaves a work Mac's security policy to its MDM, so
			# re-running it won't help, and IT may have a reason.
			warn "$desc is off (a work Mac: IT's MDM manages this)"
		else
			bad "$desc is off (re-run: script/ansible --tags security)"
		fi
	}
	# Employer Macs enroll in MDM through Automated Device Enrollment (DEP)
	# at first boot; the personal Mac's anti-theft enrollment was by hand. So
	# DEP without the work profile most likely means setup ran before the env
	# file existed, and the security setters fought the MDM.
	if [ "$DOTFILES_PROFILE" != work ] &&
		profiles status -type enrollment 2>/dev/null | grep -q 'Enrolled via DEP: Yes'; then
		warn "this Mac's MDM enrolled it at setup, like an employer's, but the profile is $DOTFILES_PROFILE (re-run script/setup --work; see MIGRATION.md#work-mac)"
	fi
	check_security "firewall" "State = 1" "$fw" --getglobalstate
	check_security "firewall stealth mode" "stealth mode is on" "$fw" --getstealthmode
	check_security "Gatekeeper" "assessments enabled" spctl --status
	check_security "FileVault" "FileVault is On" fdesetup status
	check_security "automatic update checks" "turned on" softwareupdate --schedule
	check_security "TouchID for sudo" "pam_tid.so" cat "$sudo_local"
	# sudo_local survives OS updates, but only takes effect while
	# /etc/pam.d/sudo, which updates replace, still includes it.
	check_security "sudo reads sudo_local" "^auth[[:space:]]*include[[:space:]]*sudo_local" \
		cat "${PAM_SUDO:-/etc/pam.d/sudo}"
	# -g custom: every power source, not just the current one.
	if pmset -g custom | grep -Eq 'womp[[:space:]]+1'; then
		bad "wake for network access is on (re-run: script/ansible --tags security)"
	else
		ok "wake for network access off"
	fi
	if defaults read /Library/Preferences/com.apple.loginwindow autoLoginUser >/dev/null 2>&1; then
		bad "automatic login is on (re-run: script/ansible --tags security)"
	else
		ok "automatic login off"
	fi
	# Other people's logins stay standard accounts, so installing software or
	# changing security settings needs this account's approval. Each also needs
	# a secure token, or it can't unlock FileVault after a restart. Warnings,
	# not failures: both can be deliberate, and the playbook doesn't set them.
	for user in $("$DOTFILES_ROOT/script/other-users" 2>/dev/null); do
		if dsmemberutil checkmembership -U "$user" -G admin 2>/dev/null | grep -q 'is a member'; then
			warn "$user is an administrator (System Settings > Users & Groups to make it standard)"
		else
			ok "$user is a standard account"
		fi
		# sysadminctl prints its answer to stderr.
		if sysadminctl -secureTokenStatus "$user" 2>&1 | grep -q 'ENABLED'; then
			ok "$user can unlock FileVault"
		else
			warn "$user can't unlock FileVault (sysadminctl -secureTokenOn $user -password - -adminUser \$(id -un) -adminPassword -)"
		fi
	done
fi

if [ "$(uname)" = "Darwin" ] && command -v yq >/dev/null; then
	echo "==> macOS defaults"
	# Read back every macos_defaults entry. The playbook verifies them only
	# when it runs, and an OS update, a System Settings click or the app
	# itself can change one at any time. System entries fail, as the
	# playbook's own read-back does; user entries only warn, since several
	# are documented as best-effort (macOS may defer them to System Settings).
	# check_default <system|user> <domain> <key> <value> [currentHost]
	check_default() {
		# The one templated value is the screenshot folder under $HOME.
		want=$(printf '%s' "$4" | sed "s|{{ ansible_facts\['user_dir'\] }}|$HOME|")
		if [ -n "${5:-}" ]; then
			got=$(defaults -currentHost read "$2" "$3" 2>/dev/null || true)
		else
			got=$(defaults read "$2" "$3" 2>/dev/null || true)
		fi
		# Booleans read back as 1/0 or true/false, depending on how they
		# were written; compare case-insensitively, like the playbook.
		want_lc=$(printf '%s' "$want" | tr '[:upper:]' '[:lower:]')
		got_lc=$(printf '%s' "$got" | tr '[:upper:]' '[:lower:]')
		case "$want_lc" in
			true | 1) case "$got_lc" in true | 1) got_lc=$want_lc ;; esac ;;
			false | 0) case "$got_lc" in false | 0) got_lc=$want_lc ;; esac ;;
		esac
		if [ "$got_lc" = "$want_lc" ]; then
			ok "$2 $3"
		elif [ "$1" = system ]; then
			bad "$2 $3 is ${got:-unset}, expected $want (re-run: script/ansible --tags defaults)"
		else
			warn "$2 $3 is ${got:-unset}, expected $want (re-run: script/ansible --tags defaults)"
		fi
	}
	# A work Mac skips the system entries, as the playbook does: its MDM owns
	# update policy and the login window.
	system_query='.macos_defaults.system[]'
	# A key config.yml doesn't have, so the system half yields no rows.
	[ "$DOTFILES_PROFILE" != work ] || system_query='.macos_defaults.none[]'
	defaults_rows=$(yq -r "($system_query"' | ["system", .domain, .key, .value, (.host // "")] | @tsv),
		(.macos_defaults.user[] | ["user", .domain, .key, .value, (.host // "")] | @tsv)' "$CONFIG")
	tab=$(printf '\t')
	while IFS="$tab" read -r scope domain key value host; do
		check_default "$scope" "$domain" "$key" "$value" "$host"
	done <<EOF
$defaults_rows
EOF

	# A read-back passes for a key macOS no longer reads at all, which tends
	# to happen after an OS upgrade. Warn only: the search can miss a key
	# built at runtime, so confirm one before removing it. Silent when the
	# audit can't run (no ripgrep, no binaries to search).
	if command -v rg >/dev/null; then
		"$DOTFILES_ROOT/script/audit-defaults" 2>/dev/null |
			sed -n 's/^  dead? \([^:]*\):.*/  warn  \1 may be dead: no system binary reads it (script\/audit-defaults)/p' || true
	fi
fi

if [ "$(uname)" = "Darwin" ]; then
	echo "==> App preferences"
	# Warn only: these apps rewrite their own preferences, and a change made in
	# the app may be one to copy into app-preferences/ rather than undo.
	"$DOTFILES_ROOT/script/app-preferences" --check 2>&1 |
		sed 's/^  drift \(.*\)/  warn  \1 differ from app-preferences\/ (script\/app-preferences applies them)/' || true
fi

echo "==> Dotfiles repo"
# script/update runs the Python/Ansible steps only when the venv exists, and
# skips them silently otherwise. Only macOS needs it: install.sh never creates
# it on Linux, where the playbook doesn't run, so this failed every Codespace.
if [ -f "$DOTFILES_ROOT/env/bin/activate" ]; then
	# ansible-core breaks on a Python newer than .python-version allows (3.15
	# removed dataclasses._is_type), so flag a venv built on anything else.
	want=$(cat "$DOTFILES_ROOT/.python-version" 2>/dev/null || true)
	have=$(sed -n 's/^version\(_info\)\{0,1\} = //p' "$DOTFILES_ROOT/env/pyvenv.cfg" 2>/dev/null | head -1)
	case "$have" in
		"$want" | "$want".*) ok "Python venv present (Python $have)" ;;
		*) warn "Python venv uses Python ${have:-unknown}, but .python-version says $want (run script/bootstrap)" ;;
	esac
elif [ "$(uname)" = "Darwin" ]; then
	bad "no Python venv at $DOTFILES_ROOT/env (run script/bootstrap)"
else
	ok "no Python venv (not needed on Linux)"
fi
# `up` pulls only onto a clean tree, so uncommitted changes quietly stop it
# picking up new commits.
if git -C "$DOTFILES_ROOT" diff --quiet 2>/dev/null && git -C "$DOTFILES_ROOT" diff --cached --quiet 2>/dev/null; then
	ok "working tree clean"
else
	warn "uncommitted changes in $DOTFILES_ROOT; \`up\` won't pull until they're committed"
fi

echo
if [ "$problems" -eq 0 ]; then
	echo "All checks passed."
else
	echo "$problems problem(s) found."
	exit 1
fi

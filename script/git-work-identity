#!/bin/sh
# Give a work Mac's work repos the work email, chosen by remote URL, while
# everything else keeps .gitconfig's personal one. Writes three untracked
# files:
#   ~/.config/git/work             included by .gitconfig: one
#                                  includeIf "hasconfig:remote.*.url:…" per
#                                  pattern, plus the work GitHub account for
#                                  work remotes on github.com
#   ~/.config/git/work-identity    what those includeIfs point to: the work
#                                  email, and dotfiles.workRepo = true
#   ~/.config/git/work-leaks.toml  gitleaks rules for the hooks in
#                                  .config/git/template, which block employer
#                                  details in repos that aren't work repos
#
# The inputs live in the untracked env file (lib/profile), since the employer
# isn't named in this public repo:
#   DOTFILES_WORK_EMAIL=<work-email>
#   DOTFILES_WORK_GIT_REMOTES="<gitlab-host> github.com/<org>"
#   DOTFILES_WORK_GH_USER=<work-github-login>      (optional)
#   DOTFILES_WORK_LEAK_TERMS="<employer> <tool>"   (optional)
# Each remote entry is a host, or a host and path prefix.
#
# DOTFILES_WORK_GH_USER sets credential.https://github.com/<org>.username, and
# gh's credential helper returns the token for the account it's asked for, so
# pushes to work repos over HTTPS use the work account without a
# `gh auth switch`. Only github.com entries with an org get it: a bare
# github.com would send every repo there to the work account. gh's own
# commands (gh pr create) still use the active account.
#
# The leak rules match the email's domain, each remote entry, and
# DOTFILES_WORK_LEAK_TERMS (the employer's name, internal tool names), which
# can't be derived from the other two.
#
# Matching on the remote replaced an includeIf "gitdir:~/work/" that nothing
# used, because repos live in ~/projects and ~/github. The default stays
# personal: a fresh `git init` has no remote at its first commit, and a work
# default would put the employer into a new public repo.
#
# On the personal profile it removes all three files, so a Mac switched back with
# `script/setup --personal` loses the override. Prints "changed" when it
# writes or removes anything, for the playbook's changed_when.
# Usage: script/git-work-identity [--check]
#   --check  change nothing; exit 1 if the files don't match the env file

set -eu
# shellcheck disable=SC3040
(set -o pipefail) 2>/dev/null && set -o pipefail || true

check=false
[ "${1:-}" != --check ] || check=true

# shellcheck source=lib/profile
. "$(dirname "$0")/../lib/profile"

# Not $XDG_CONFIG_HOME: .gitconfig includes this literal path.
dir="$HOME/.config/git"
selector="$dir/work"
identity="$dir/work-identity"
leaks="$dir/work-leaks.toml"

drift() {
	echo "git-work-identity: $1" >&2
	exit 1
}

if [ "$DOTFILES_PROFILE" != work ]; then
	[ -e "$selector" ] || [ -e "$identity" ] || [ -e "$leaks" ] || exit 0
	$check && drift "$selector, $identity or $leaks is left over from the work profile (run script/git-work-identity)"
	rm -f "$selector" "$identity" "$leaks"
	echo changed
	exit 0
fi

for var in DOTFILES_WORK_EMAIL DOTFILES_WORK_GIT_REMOTES; do
	eval "val=\${$var:-}"
	# shellcheck disable=SC2154
	[ -n "$val" ] || drift "set $var in $DOTFILES_ENV_FILE, or work repos commit with the personal email (see MIGRATION.md#work-mac)"
done

# The path is written with ~ so the file doesn't depend on the account name.
# dotfiles.workRepo marks work repos for the leak-guard hooks, through the
# same remote match as the email.
want_identity=$(printf '[user]\n\temail = %s\n[dotfiles]\n\tworkRepo = true\n' "$DOTFILES_WORK_EMAIL")
# One entry per line, whether the list is space- or newline-separated. Not
# xargs: it treats quotes as syntax, so a term like Macy's failed the script.
entries() { printf '%s\n' "$1" | tr -s ' \t' '\n' | sed '/^$/d'; }
want_selector=$(
	echo "# Written by script/git-work-identity from $DOTFILES_ENV_FILE; edit that, not this."
	entries "$DOTFILES_WORK_GIT_REMOTES" | while read -r entry; do
		entry=${entry%/}
		host=${entry%%/*}
		path=${entry#"$host"}
		path=${path#/}
		# HTTPS, scp-style SSH, and ssh:// with and without a port: a
		# self-hosted GitLab often runs SSH on a port other than 22. git
		# matches with wildmatch, where ** spans slashes only right after
		# one, so the scp form's bare host needs `*/**` (group/repo).
		for pattern in \
			"https://$host/${path:+$path/}**" \
			"git@$host:${path:-*}/**" \
			"ssh://git@$host/${path:+$path/}**" \
			"ssh://git@$host:*/${path:+$path/}**"; do
			printf '[includeIf "hasconfig:remote.*.url:%s"]\n\tpath = ~/.config/git/work-identity\n' "$pattern"
		done
		# git matches credential.<url> by whole path segments, so
		# github.com/org doesn't also catch github.com/org-fork.
		if [ -n "${DOTFILES_WORK_GH_USER:-}" ] && [ "$host" = github.com ] && [ -n "$path" ]; then
			printf '[credential "https://github.com/%s"]\n\tusername = %s\n' "$path" "$DOTFILES_WORK_GH_USER"
		fi
	done
)
# One case-insensitive alternation of every term, regex-escaped, in a TOML
# literal string (triple single quotes), so backslashes need no second
# escaping. Without a rule file the hooks skip the check.
want_leaks=$(
	terms=$(
		{
			echo "${DOTFILES_WORK_EMAIL#*@}"
			entries "$DOTFILES_WORK_GIT_REMOTES" | sed 's|/*$||'
			entries "${DOTFILES_WORK_LEAK_TERMS:-}"
		} | sed '/^$/d; s/[][\\.*^$+?(){}|]/\\&/g' | sort -u | paste -sd '|' -
	)
	q="'''"
	echo "# Written by script/git-work-identity from $DOTFILES_ENV_FILE; edit that, not this."
	echo 'title = "work details outside work repos"'
	echo
	echo '[[rules]]'
	echo 'id = "work-detail"'
	echo 'description = "An employer detail in a repo that is not a work repo"'
	echo "regex = $q(?i)($terms)$q"
)

changed=false
sync() { # <file> <content>
	[ -f "$1" ] && [ "$(cat "$1")" = "$2" ] && return 0
	$check && drift "$1 doesn't match $DOTFILES_ENV_FILE (run script/git-work-identity)"
	mkdir -p "$dir"
	printf '%s\n' "$2" >"$1"
	changed=true
}
sync "$selector" "$want_selector"
sync "$identity" "$want_identity"
sync "$leaks" "$want_leaks"
! $changed || echo changed

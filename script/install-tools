#!/bin/sh
# Install essential CLI tools on Linux for dotfiles compatibility.
# Called by install.sh (dotfiles integration) and post-create.sh (devcontainer).
# On macOS these tools are installed via Homebrew/Brewfile instead.

set -e

if [ "$(uname)" = "Darwin" ]; then
	echo "Skipping install-tools on macOS (use Homebrew instead)"
	exit 0
fi

# On rpm-based systems (Fedora), everything is in the distro repos
if command -v dnf >/dev/null; then
	echo "==> Installing tools via dnf..."
	sudo dnf install -y git-delta zoxide fzf
	echo "==> Tool installation complete"
	exit 0
fi

# Elsewhere (Debian/Ubuntu, Codespaces), install through mise. It verifies each
# download against the GitHub API's SHA256 digest, which this script used to do
# by hand across ~100 lines of release-JSON parsing, and the mise.run installer
# checks mise itself against a checksum baked into the script.
missing=""
for tool in delta zoxide fzf; do
	command -v "$tool" >/dev/null || missing="$missing $tool"
done
if [ -z "$missing" ]; then
	echo "==> Tools already installed"
	exit 0
fi

MISE=$(command -v mise || echo "$HOME/.local/bin/mise")
if [ ! -x "$MISE" ]; then
	echo "==> Installing mise..."
	curl -fsSL https://mise.run | sh
fi

echo "==> Installing$missing via mise..."
# Not `mise use -g`: install.sh symlinks ~/.config/mise/config.toml to the
# repo's copy, so -g would write these into a tracked file. mise also loads
# conf.d/*.toml as global config, so this file keeps them installed and
# upgradable by `mise upgrade` without touching the repo.
# shellcheck disable=SC2086 # $missing is a space-separated tool list
"$MISE" use --path "$HOME/.config/mise/conf.d/install-tools.toml" $missing

# Link the shims onto the system PATH. zsh loads oh-my-zsh's zoxide plugin
# before `mise activate` runs, and the plugin only initializes if zoxide is
# already on PATH. Shims resolve the current version at run time, so these
# links survive upgrades.
for tool in $missing; do
	sudo ln -sf "$HOME/.local/share/mise/shims/$tool" "/usr/local/bin/$tool"
done

echo "==> Tool installation complete"

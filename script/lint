#!/bin/sh
# Run every linter, then list the ones that failed. Stopping at the first
# failure hid the rest: CI was once red for five pushes in a row as each fix
# uncovered the next linter's error.
# Usage: script/lint

set -eu
# shellcheck disable=SC3040
(set -o pipefail) 2>/dev/null && set -o pipefail || true

cd "$(dirname "$0")/.."

script/blocking-io

failed=""
# lint <description> <command>...: run one linter, recording a failure.
lint() {
	desc=$1
	shift
	echo "==> $desc..."
	"$@" || failed="$failed
    $desc"
}

# Shell files: scripts, the libs sourced by .zshrc, the BATS suite, and the
# Claude Code hooks.
SHELL_FILES="script/* install.sh lib/* test/*.bats test/test_helper.bash .devcontainer/post-create.sh .claude/hooks/* claude/hooks/*"

# zsh_syntax <file>...: zsh -n each file (given several, zsh -n would parse
# only the first and treat the rest as its arguments).
zsh_syntax() {
	rc=0
	for f; do
		zsh -n "$f" || rc=1
	done
	return "$rc"
}

# git_config_syntax <file>...: git config refuses to list a malformed file.
git_config_syntax() {
	rc=0
	for f; do
		git config -f "$f" --list >/dev/null || rc=1
	done
	return "$rc"
}

if [ ! -f env/bin/activate ]; then
	echo "script/lint: no Python venv; run script/bootstrap first" >&2
	exit 1
fi
# shellcheck disable=SC1091
. env/bin/activate

lint "Linting Ansible playbook" ansible-lint playbook.yml
lint "Linting YAML files" yamllint ./*.yml .ansible-lint .yamllint .github/workflows/*.yml
# The venv's Python, for tomllib: macOS's system python3 predates it. A broken
# mise config breaks every new shell.
lint "Checking TOML syntax" python3 -c '
import sys, tomllib
for f in sys.argv[1:]:
    with open(f, "rb") as fh:
        tomllib.load(fh)
' .config/mise/config.toml .config/starship.toml .config/atuin/config.toml

deactivate

# SHELL_FILES is split into words and globs on purpose.
# shellcheck disable=SC2086
lint "Linting shell scripts" shellcheck $SHELL_FILES
# shellcheck disable=SC2086
lint "Checking shell formatting" shfmt -d -i 0 -ci $SHELL_FILES
# ShellCheck can't parse zsh, so the zsh-only files get a syntax check, and
# the libs .zshrc sources get checked as zsh as well as sh.
lint "Checking zsh syntax" zsh_syntax .zshrc .zprofile .zshenv lib/*
lint "Checking git config syntax" git_config_syntax .gitconfig .gitconfig.macos
lint "Linting GitHub Actions workflows" actionlint
# bundle exec, so the Gemfile's rubocop pin applies rather than whatever
# version happens to be installed.
lint "Linting Ruby files" bundle exec rubocop --force-exclusion .irbrc .pryrc Gemfile
# .rubocop.yml excludes the Brewfile, and nothing in CI runs brew bundle, so a
# syntax error would first surface in a nightly `up`.
lint "Checking Brewfile syntax" ruby -c Brewfile
# --frail: fail on warnings too, or a broken link only warns and CI stays green.
lint "Linting Markdown files" npx remark --no-stdout --silently-ignore --frail \
	--ignore-pattern node_modules/ --ignore-pattern .ansible/ --ignore-pattern env/ \
	--ignore-pattern vendor/ .

if [ -n "$failed" ]; then
	echo "==> Failed:$failed" >&2
	exit 1
fi
echo "==> All linters passed!"

#!/bin/sh

set -eu
# shellcheck disable=SC3040
(set -o pipefail) 2>/dev/null && set -o pipefail || true

# bootstrap and ansible are called by relative path, and install.sh and the
# `setup` alias both exec this from wherever the caller happens to be.
cd "$(dirname "$0")/.."

echo "==> Bootstrapping environment..."
script/bootstrap

echo "==> Running Ansible playbook..."
script/ansible

# The playbook installs packages but doesn't run the rest of `up` (mas
# upgrade, npm ci, bundle, pip, oh-my-zsh, tldr), so a new machine would
# otherwise wait for the first nightly run to get them (#73).
echo "==> Updating everything..."
script/update

#!/bin/sh
# Update all installed dependencies
# Usage: up

set -eu
# shellcheck disable=SC3040
(set -o pipefail) 2>/dev/null && set -o pipefail || true

cd "${DOTFILES_ROOT:-$HOME/.files}"

# This script may run from a minimal environment (e.g. the nightly launchd job,
# whose PATH is only /usr/bin:/bin:/usr/sbin:/sbin), so make Homebrew
# discoverable. Mirror lib/globals: Workbrew's wrapper must precede
# /opt/homebrew/bin or brew aborts with a wrapper-conflict error. Prepend in
# ascending priority so the last entry wins. No-op where a path is absent.
[ -x /opt/homebrew/bin/brew ] && PATH="/opt/homebrew/bin:$PATH"
[ -x /home/linuxbrew/.linuxbrew/bin/brew ] && PATH="/home/linuxbrew/.linuxbrew/bin:$PATH"
[ -x /opt/workbrew/bin/brew ] && PATH="/opt/workbrew/bin:$PATH"

# Resolve mise-managed runtimes (ruby, node, …) ahead of Homebrew's. This
# non-interactive script never runs mise's shell hook, so without the shims
# `bundle`/`npm` fall back to Homebrew's Ruby/Node, whose gem and package dirs
# are owned by Workbrew and not user-writable (bundle install then fails with
# Bundler::PermissionError). Shims only shadow installed tools, so `brew` still
# resolves to the wrapper above.
[ -d "$HOME/.local/share/mise/shims" ] && PATH="$HOME/.local/share/mise/shims:$PATH"
export PATH

if command -v brew >/dev/null; then
	echo "==> Updating Homebrew packages..."
	# Keep errors visible but don't let `set -e` abort here: a single wedged
	# cask must not skip every step below (dnf, mas, mise, npm, gems, pip).
	brew update || true
	brew outdated || true

	# Never upgrade casks that update themselves. Homebrew used to skip these
	# unless asked with --greedy; it now upgrades them by default and points at
	# this variable to opt out. The default is actively harmful here: the app has
	# already replaced itself in /Applications, so Homebrew's recorded version is
	# stale (Chrome 149 vs 152, VS Code 1.128 vs 1.133). Its uninstall step then
	# moves the live app back onto the old Caskroom stage, hits the copy already
	# sitting there, and dies with "It seems there is already an App at ...",
	# rolling back and re-orphaning the stage. 8.7GB of orphaned app bundles had
	# accumulated this way. Non-auto-updating casks still upgrade normally.
	export HOMEBREW_NO_UPGRADE_AUTO_UPDATES_CASKS=1

	# Cask upgrades replace GUI apps: they need an interactive sudo and a GUI
	# session to quit the running app, neither of which the headless nightly
	# launchd job has. From a terminal, upgrade everything; when headless,
	# upgrade only formulae so self-updating casks don't fail (and re-orphan a
	# stale Caskroom stage) on every run.
	if [ -t 1 ]; then
		brew upgrade || true
	else
		brew upgrade --formula || true
	fi

	# --no-upgrade: install missing entries only. bundle does its own cask
	# upgrades, which the variable above does not cover — that is how spotify
	# got wedged the same way. Upgrades are line 42's job. Mirrors the
	# playbook's macOS bundle task.
	echo "==> Installing any new Brewfile entries..."
	brew bundle --global --no-upgrade || true

	# Prune orphaned dependencies and clear stale downloads/old versions. Both
	# are non-interactive and safe headless, so they run every invocation
	# (unlike cask upgrades). Housekeeping only: never removes a package you
	# asked for. To prune unused casks, see script/audit-casks, which needs a
	# human to judge what's actually unused.
	echo "==> Removing unused dependencies and old versions..."
	brew autoremove || true
	brew cleanup || true

	# Re-staging the microsoft-auto-update cask (above) resets MAU to
	# AutomaticCheck and re-registers its launch agent, so it starts popping
	# the "Check for Updates" window several times a day. Pin it back to Manual
	# after every bundle so the nightly run stops clobbering the setting. macOS
	# only; the domain is absent elsewhere, so guard on `defaults`.
	if command -v defaults >/dev/null; then
		defaults write com.microsoft.autoupdate2 HowToCheck Manual || true
	fi

	# Propose pruning casks whose app hasn't been opened in a while by
	# commenting them out of the Brewfile. Interactive only: it edits a
	# version-controlled dotfile off Spotlight's last-opened data, so it must
	# never run unattended in the nightly launchd job. It only ever comments
	# (never uninstalls) — review the diff and run `clean` to act on it. Tune
	# the window with AUDIT_STALE_DAYS (default 14).
	AUDIT="${DOTFILES_ROOT:-$HOME/.files}/script/audit-casks"
	if [ -t 1 ] && [ -x "$AUDIT" ]; then
		echo "==> Auditing casks for disuse..."
		"$AUDIT" --comment || true
	fi
fi

if command -v dnf >/dev/null; then
	echo "==> Updating dnf packages..."
	# dnf needs root. From a terminal, allow an interactive sudo prompt. Headless
	# (the nightly launchd/cron job) there's no one to answer it, so use `sudo -n`
	# to fail fast instead of hanging on a password prompt, and `|| true` so a
	# skipped upgrade doesn't abort the steps below (mas, mise, npm, gems, pip).
	if [ -t 1 ]; then
		sudo dnf upgrade --refresh -y || true
	else
		sudo -n dnf upgrade --refresh -y || true
	fi
fi

if command -v mas >/dev/null; then
	echo "==> Updating Mac App Store apps..."
	mas upgrade || true
fi

if command -v mise >/dev/null; then
	echo "==> Updating mise tools..."
	mise upgrade 2>/dev/null || true
fi

if command -v npm >/dev/null; then
	# `npm ci`, not `npm update`: these are only the repo's lint tools, and
	# update rewrote the tracked package-lock.json nightly, leaving a dirty tree
	# to commit by hand. Renovate owns version bumps; this just installs them.
	echo "==> Installing npm packages..."
	npm ci || true
fi

if command -v bundle >/dev/null; then
	echo "==> Updating Ruby gems..."
	bundle update || true
fi

echo "==> Updating Python packages..."
if [ -d env ]; then
	# shellcheck disable=SC1091
	. env/bin/activate
	if command -v uv >/dev/null; then
		uv pip install --upgrade -r requirements.txt || true
	else
		pip install --upgrade -r requirements.txt || true
	fi

	# Split the role and collection halves; the old combined `install --force`
	# re-downloaded everything every run. Collections are pinned to exact
	# versions (Renovate opens the bump PRs), so a plain install converges on its
	# own: it installs whenever the pin is unsatisfied, in either direction, and
	# no-ops when it already matches. Roles still need --force -- `role install`
	# has no --upgrade and otherwise refuses to touch an already-installed role
	# ("use --force to change version to 2.4.0"), so a pin bump would silently
	# never apply. One small role, so the re-download is cheap.
	echo "==> Updating Ansible roles and collections..."
	ansible-galaxy role install -r requirements.yml --force || true
	ansible-galaxy collection install -r requirements.yml || true
	deactivate
fi

# Mole deep-cleans and optimizes macOS. It's interactive (may prompt for sudo)
# and macOS-only, so run it last and only from a terminal — never the headless
# nightly launchd job, which mirrors the cask-upgrade guard above.
if command -v mole >/dev/null && [ -t 1 ]; then
	echo "==> Cleaning up and optimizing with mole..."
	mole clean || true
	mole optimize || true
fi

#!/bin/sh
# Update all installed dependencies
# Usage: up

set -eu
# shellcheck disable=SC3040
(set -o pipefail) 2>/dev/null && set -o pipefail || true

# Absolute, so the re-exec after a pull still finds this script when it was
# started by a relative path from outside the repo.
SELF="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
cd "${DOTFILES_ROOT:-$HOME/.files}"

# The repo's Brewfile, not --global: ~/.Brewfile is only linked on macOS, so
# on Linux every bundle step failed for want of a file. There, also skip the
# formulae with no Linux bottle, as the playbook does.
export HOMEBREW_BUNDLE_FILE="$PWD/Brewfile"
if [ "$(uname)" != "Darwin" ]; then
	HOMEBREW_BUNDLE_BREW_SKIP=$(sed -n 's/^homebrew_linux_brew_skip: *//p' config.yml 2>/dev/null || true)
	export HOMEBREW_BUNDLE_BREW_SKIP
fi

# This script may run from a minimal environment (e.g. the nightly launchd job,
# whose PATH is only /usr/bin:/bin:/usr/sbin:/sbin), so make Homebrew
# discoverable. Mirror lib/globals: Workbrew's wrapper must precede
# /opt/homebrew/bin or brew aborts with a wrapper-conflict error. Prepend in
# ascending priority so the last entry wins. No-op where a path is absent.
[ -x /opt/homebrew/bin/brew ] && PATH="/opt/homebrew/bin:$PATH"
[ -x /home/linuxbrew/.linuxbrew/bin/brew ] && PATH="/home/linuxbrew/.linuxbrew/bin:$PATH"
[ -x /opt/workbrew/bin/brew ] && PATH="/opt/workbrew/bin:$PATH"

# Resolve mise-managed runtimes (ruby, node, …) ahead of Homebrew's. This
# non-interactive script never runs mise's shell hook, so without the shims
# `bundle`/`npm` fall back to Homebrew's Ruby/Node, whose gem and package dirs
# are owned by Workbrew and not user-writable (bundle install then fails with
# Bundler::PermissionError). Shims only shadow installed tools, so `brew` still
# resolves to the wrapper above.
[ -d "$HOME/.local/share/mise/shims" ] && PATH="$HOME/.local/share/mise/shims:$PATH"
export PATH

# Steps end in `|| true`-style tolerance so one failure doesn't skip the rest,
# but that used to make the script always exit 0: the nightly job looked
# healthy to launchctl and script/doctor no matter what broke. step records
# each failed command instead, and the summary at the bottom exits 1.
failed=""
step() {
	"$@" || failed="$failed
    $*"
}

# Headless, stdout is launchd's append-only log, which nothing else rotates.
# Keep the tail. `cat >` rewrites the same inode, and launchd opened it with
# O_APPEND, so this run's output still lands at the (new) end.
UPDATE_LOG="${DOTFILES_UPDATE_LOG:-$HOME/Library/Logs/dotfiles-update.log}"
if ! [ -t 1 ] && [ -f "$UPDATE_LOG" ] && [ "$(wc -l <"$UPDATE_LOG")" -gt 10000 ]; then
	tail -n 5000 "$UPDATE_LOG" >"$UPDATE_LOG.tmp" && cat "$UPDATE_LOG.tmp" >"$UPDATE_LOG"
	rm -f "$UPDATE_LOG.tmp"
fi

echo "==> Started $(date)"

# From a terminal, fast-forward the dotfiles first so new Brewfile entries and
# requirement pins apply this run. Skipped headless (a pull that needs auth or
# conflicts has no one to see it) and on a dirty tree (an in-progress Brewfile
# edit must never be merged into unattended). If it moved HEAD, re-exec so the
# rest runs the freshly pulled copy of this script, not the one sh already
# half-read.
if [ -t 1 ] && [ -z "${DOTFILES_UPDATE_PULLED:-}" ] && command -v git >/dev/null &&
	git diff --quiet && git diff --cached --quiet; then
	echo "==> Pulling dotfiles..."
	before=$(git rev-parse HEAD)
	step git pull --ff-only
	if [ "$(git rev-parse HEAD)" != "$before" ]; then
		DOTFILES_UPDATE_PULLED=1 exec "$SELF" "$@"
	fi
fi

# launchd runs a missed midnight job when the Mac wakes, which can land on top
# of a manual `up`; two brews at once fail on each other's locks. mkdir is
# atomic. A lock left by a killed run is reclaimed once its PID is gone. Not
# under $TMPDIR: launchd doesn't set it, so the nightly job and a terminal
# would each lock a different directory and never see each other.
LOCK="${XDG_CACHE_HOME:-$HOME/.cache}/dotfiles-update.lock"
mkdir -p "${LOCK%/*}"
if ! mkdir "$LOCK" 2>/dev/null; then
	pid=$(cat "$LOCK/pid" 2>/dev/null || true)
	if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
		echo "==> Another update (PID $pid) is running; skipping." >&2
		exit 0
	fi
	rm -rf "$LOCK"
	mkdir "$LOCK"
fi
echo "$$" >"$LOCK/pid"
trap 'rm -rf "$LOCK"' EXIT
# dash skips the EXIT trap on a signal; exiting from these traps runs it.
trap 'exit 130' INT
trap 'exit 143' TERM

# What script/doctor reads to report the last run. Not the launchd log: mole
# and other cleaners sweep ~/Library/Logs, and Linux has no launchd log at all.
STATUS="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles/update-status"
mkdir -p "${STATUS%/*}"
echo "started=$(date '+%Y-%m-%d %H:%M')" >"$STATUS"

if command -v brew >/dev/null; then
	echo "==> Updating Homebrew packages..."
	# step keeps errors visible but doesn't let `set -e` abort here: a single
	# wedged cask must not skip every step below (dnf, mas, mise, npm, gems, pip).
	step brew update
	# Informational only, so not a step: nothing to count as failed.
	brew outdated || true

	# Never upgrade casks that update themselves. Homebrew used to skip these
	# unless asked with --greedy; it now upgrades them by default and points at
	# this variable to opt out. The default is actively harmful here: the app has
	# already replaced itself in /Applications, so Homebrew's recorded version is
	# stale (Chrome 149 vs 152, VS Code 1.128 vs 1.133). Its uninstall step then
	# moves the live app back onto the old Caskroom stage, hits the copy already
	# sitting there, and dies with "It seems there is already an App at ...",
	# rolling back and re-orphaning the stage. 8.7GB of orphaned app bundles had
	# accumulated this way. Non-auto-updating casks still upgrade normally.
	export HOMEBREW_NO_UPGRADE_AUTO_UPDATES_CASKS=1

	# Cask upgrades replace GUI apps: they need an interactive sudo and a GUI
	# session to quit the running app, neither of which the headless nightly
	# launchd job has. From a terminal, upgrade everything; when headless,
	# upgrade only formulae so self-updating casks don't fail (and re-orphan a
	# stale Caskroom stage) on every run.
	if [ -t 1 ]; then
		step brew upgrade
	else
		step brew upgrade --formula
	fi

	# --no-upgrade: install missing entries only. bundle does its own cask
	# upgrades, which the variable above does not cover — that is how spotify
	# got wedged the same way. Upgrades are the `brew upgrade` block's job.
	# Mirrors the playbook's macOS bundle task.
	# Headless, skip casks and App Store apps for the same reasons as their
	# upgrades: a new cask can want sudo, and mas can wait forever on an App
	# Store sign-in while holding the update lock. The next `up` from a
	# terminal installs them.
	echo "==> Installing any new Brewfile entries..."
	if [ -t 1 ]; then
		step brew bundle install --no-upgrade
	else
		# Exported, not prefixed: an assignment before a function call (step)
		# isn't reliably passed on in POSIX sh.
		HOMEBREW_BUNDLE_CASK_SKIP=$(sed -n "s/^cask '\([^']*\)'.*/\1/p" Brewfile 2>/dev/null | tr '\n' ' ' || true)
		HOMEBREW_BUNDLE_MAS_SKIP=$(sed -n 's/^mas .*id: *\([0-9_]*\).*/\1/p' Brewfile 2>/dev/null | tr -d _ | tr '\n' ' ' || true)
		export HOMEBREW_BUNDLE_CASK_SKIP HOMEBREW_BUNDLE_MAS_SKIP
		step brew bundle install --no-upgrade
		unset HOMEBREW_BUNDLE_CASK_SKIP HOMEBREW_BUNDLE_MAS_SKIP
	fi

	# Prune orphaned dependencies and clear stale downloads/old versions. Both
	# are non-interactive and safe headless, so they run every invocation
	# (unlike cask upgrades). Housekeeping only: never removes a package you
	# asked for. To prune unused casks, see script/audit-casks, which needs a
	# human to judge what's actually unused.
	echo "==> Removing unused dependencies and old versions..."
	step brew autoremove
	step brew cleanup

	# Re-staging the microsoft-auto-update cask (above) resets MAU to
	# AutomaticCheck and re-registers its launch agent, so it starts popping
	# the "Check for Updates" window several times a day. Pin it back to Manual
	# after every bundle so the nightly run stops clobbering the setting. macOS
	# only; the domain is absent elsewhere, so guard on `defaults`.
	if command -v defaults >/dev/null; then
		step defaults write com.microsoft.autoupdate2 HowToCheck Manual
	fi

	# Propose pruning casks whose app hasn't been opened in a while by
	# commenting them out of the Brewfile. Interactive only: it edits a
	# version-controlled dotfile off Spotlight's last-opened data, so it must
	# never run unattended in the nightly launchd job. It only ever comments
	# (never uninstalls) — review the diff and run `clean` to act on it. Tune
	# the window with AUDIT_STALE_DAYS (default 14).
	AUDIT="${DOTFILES_ROOT:-$HOME/.files}/script/audit-casks"
	if [ -t 1 ] && [ -x "$AUDIT" ]; then
		echo "==> Auditing casks for disuse..."
		step "$AUDIT" --comment
	fi
fi

if command -v dnf >/dev/null; then
	echo "==> Updating dnf packages..."
	# dnf needs root. From a terminal, allow an interactive sudo prompt. Headless
	# (the nightly launchd/cron job) there's no one to answer it, so use `sudo -n`
	# to fail fast instead of hanging on a password prompt, and step so a
	# skipped upgrade doesn't abort the steps below (mas, mise, npm, gems, pip).
	if [ -t 1 ]; then
		step sudo dnf upgrade --refresh -y
	else
		step sudo -n dnf upgrade --refresh -y
	fi
fi

# Terminal only: headless, mas can hang on an App Store sign-in prompt and
# hold the update lock until someone kills it.
if command -v mas >/dev/null && [ -t 1 ]; then
	echo "==> Updating Mac App Store apps..."
	step mas upgrade
fi

if command -v mise >/dev/null; then
	echo "==> Updating mise tools..."
	step mise upgrade
fi

if command -v npm >/dev/null; then
	# `npm ci`, not `npm update`: these are only the repo's lint tools, and
	# update rewrote the tracked package-lock.json nightly, leaving a dirty tree
	# to commit by hand. Renovate owns version bumps; this just installs them.
	echo "==> Installing npm packages..."
	step npm ci
fi

if command -v bundle >/dev/null; then
	echo "==> Updating Ruby gems..."
	step bundle update
fi

echo "==> Updating Python packages..."
if [ -d env ]; then
	# shellcheck disable=SC1091
	. env/bin/activate
	if command -v uv >/dev/null; then
		step uv pip install --upgrade -r requirements.txt
	else
		step pip install --upgrade -r requirements.txt
	fi

	# Not --force; the old `install --force` re-downloaded everything every
	# run. Collections are pinned to exact versions (Renovate opens the bump
	# PRs), so a plain install converges on its own: it installs whenever the
	# pin is unsatisfied, in either direction, and no-ops when it already
	# matches. (Roles would need --force to apply a pin bump, since `role
	# install` has no --upgrade; requirements.yml has none today.)
	echo "==> Updating Ansible collections..."
	step ansible-galaxy collection install -r requirements.yml
	deactivate
fi

# oh-my-zsh only updates itself when a new shell prompts for it, so a machine
# that lives in long-running terminals drifts for weeks. Its upgrade script is
# non-interactive unless passed -i. It's zsh, not sh.
export ZSH="${ZSH:-$HOME/.oh-my-zsh}"
if [ -f "$ZSH/tools/upgrade.sh" ] && command -v zsh >/dev/null; then
	echo "==> Updating oh-my-zsh..."
	step zsh "$ZSH/tools/upgrade.sh" -v minimal
fi

# tealdeer's page cache is otherwise refreshed only when it notices it's stale,
# mid-lookup.
if command -v tldr >/dev/null; then
	echo "==> Updating tldr pages..."
	step tldr --update
fi

# Report pending macOS updates without installing them: installs can restart
# the machine, which is never OK unattended. Listing is read-only.
if command -v softwareupdate >/dev/null; then
	echo "==> Checking for macOS updates..."
	# Informational, like `brew outdated`, and needs the network: not a step.
	softwareupdate --list || true
fi

# Mole deep-cleans and optimizes macOS. It's interactive (may prompt for sudo)
# and macOS-only, so run it last and only from a terminal — never the headless
# nightly launchd job, which mirrors the cask-upgrade guard above.
if command -v mole >/dev/null && [ -t 1 ]; then
	echo "==> Cleaning up and optimizing with mole..."
	step mole clean
	step mole optimize
fi

echo "==> Finished $(date)"
echo "finished=$(date '+%Y-%m-%d %H:%M')" >>"$STATUS"
if [ -n "$failed" ]; then
	echo "$failed" | sed -n 's/^    /failed=/p' >>"$STATUS"
	echo "==> Failed steps:$failed" >&2
	exit 1
fi
